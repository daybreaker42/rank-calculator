rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. 기본 과목 정보: 누구나 검색 가능
    match /subjects/{subjectId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    // 2. 상세 통계 데이터: '해당 시험'에 투표한 기록(votes)이 있는 사람만 읽기 가능
    match /subjects/{subjectId}/stats/{type} {
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/votes/$(request.auth.uid + "_" + subjectId + "_" + type));
      allow write: if false; // Cloud Functions에서 처리
    }

    // 3. 투표 및 댓글: 기존 규칙 유지
    match /votes/{voteId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    match /comments/{commentId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /favorites/{favId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
